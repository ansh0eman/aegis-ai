# Existing private application configuration. Never prefix either key with NEXT_PUBLIC_.
OPENAI_API_KEY=replace_for_authenticated_chat_only
AUTH_SECRET=replace_with_a_long_random_value
# Local HTTP only. Set true for any public HTTPS deployment.
AUTH_COOKIE_SECURE=false

# Optional isolated public Full Application Demo. Leave disabled until a
# dedicated deployment volume uses AEGIS_DATABASE_PATH=/data/aegis-public-demo.db.
AEGIS_PUBLIC_DEMO_DATABASE=false
PUBLIC_DEMO_ACCOUNTS_ENABLED=false
PUBLIC_DEMO_OPENAI_ENABLED=false
PUBLIC_DEMO_DAILY_REQUEST_LIMIT=20
PUBLIC_DEMO_MAX_OUTPUT_TOKENS=512
PUBLIC_DEMO_MAX_PROMPT_CHARS=1200
PUBLIC_DEMO_MAX_DURATION_MS=25000
PUBLIC_DEMO_LOGIN_PER_EMAIL_HOURLY_LIMIT=6
PUBLIC_DEMO_LOGIN_PER_IP_HOURLY_LIMIT=20
PUBLIC_DEMO_ADMIN_EMAIL=demo-admin@example.com
PUBLIC_DEMO_USER1_EMAIL=demo-user1@example.com
PUBLIC_DEMO_USER2_EMAIL=demo-user2@example.com
PUBLIC_DEMO_REVEAL_CREDENTIALS=false
# Only set these deliberately public credentials after operator approval.
PUBLIC_DEMO_ADMIN_PASSWORD=
PUBLIC_DEMO_USER1_PASSWORD=
PUBLIC_DEMO_USER2_PASSWORD=

# Public demo inference. Keep disabled until the Groq account/project billing
# page confirms the free tier and free-plan limits for this key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DEMO_LIVE_INFERENCE_ENABLED=false
DEMO_GROQ_FREE_TIER_CONFIRMED=false

# Server-side abuse controls. These settings have hard upper bounds in code.
DEMO_GLOBAL_DAILY_REQUEST_LIMIT=60
DEMO_PER_IP_HOURLY_LIMIT=5
DEMO_MAX_PROMPT_CHARS=1200
DEMO_MAX_OUTPUT_TOKENS=256
DEMO_MAX_DURATION_MS=25000

# Set to "railway" only when requests reach the app through Railway's trusted
# HTTP proxy. In local development, leave this off and rely on the shared cap.
DEMO_TRUSTED_PROXY=off
