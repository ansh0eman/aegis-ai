*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*-journal
*-wal
*-shm

# Logs and generated metadata.
*.log
npm-debug.log*
yarn-debug.log*
*.tsbuildinfo
.DS_Store
